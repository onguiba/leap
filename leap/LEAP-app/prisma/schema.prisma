// Schéma Prisma pour MALAP METSI
// Base de données PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  image       String?  @db.VarChar(10)
  imageUrl    String?  @db.VarChar(500)
  category    String   @db.VarChar(100)
  barcode     String   @unique @db.VarChar(13)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  prices      Price[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([barcode])
  @@index([category])
  @@map("products")
}

model Store {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  logo        String?  @db.VarChar(10)
  city        String   @db.VarChar(100)
  address     String   @db.Text
  phone       String?  @db.VarChar(20)
  hours       String?  @db.VarChar(50)
  delivery    Boolean  @default(true)
  deliveryFee Int      @default(500) @map("delivery_fee")
  minOrder    Int      @default(5000) @map("min_order")
  rating      Decimal  @default(0.0) @db.Decimal(2, 1)
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  createdAt   DateTime @default(now()) @map("created_at")

  prices     Price[]
  orderItems OrderItem[]

  @@index([city])
  @@map("stores")
}

model Price {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  storeId   Int      @map("store_id")
  price     Int
  stock     Int?     @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
  @@map("prices")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  email         String?  @unique @db.VarChar(255)
  phone         String   @unique @db.VarChar(20)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  role          String   @default("user") @db.VarChar(20)
  lastLoginAt   DateTime? @map("last_login_at")
  address       String?  @db.Text
  walletBalance Int      @default(0) @map("wallet_balance")
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  loyaltyLevel  String   @default("Bronze") @map("loyalty_level") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  orders            Order[]
  reviews           Review[]
  walletTransactions WalletTransaction[]
  authEvents        AuthEvent[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model AuthEvent {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  identifier String   @db.VarChar(100)
  role       String   @default("user") @db.VarChar(20)
  status     String   @db.VarChar(20)
  reason     String?  @db.VarChar(100)
  occurredAt DateTime @default(now()) @map("occurred_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier])
  @@index([occurredAt])
  @@map("auth_events")
}

model Order {
  id              String   @id @db.VarChar(50)
  userId          Int      @map("user_id")
  status          String   @default("pending") @db.VarChar(20)
  subtotal        Int
  deliveryFee     Int      @default(0) @map("delivery_fee")
  total           Int
  paymentMethod   String?  @map("payment_method") @db.VarChar(50)
  deliveryAddress String?  @map("delivery_address") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  delivery  Delivery?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   String @map("order_id") @db.VarChar(50)
  productId Int    @map("product_id")
  storeId   Int    @map("store_id")
  quantity  Int
  price     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model DeliveryDriver {
  id      Int      @id @default(autoincrement())
  name    String   @db.VarChar(255)
  phone   String?  @db.VarChar(20)
  vehicle String?  @db.VarChar(100)
  rating  Decimal  @default(0.0) @db.Decimal(2, 1)
  active  Boolean  @default(true)

  deliveries Delivery[]

  @@map("delivery_drivers")
}

model Delivery {
  id            Int       @id @default(autoincrement())
  orderId       String    @unique @map("order_id") @db.VarChar(50)
  driverId      Int?      @map("driver_id")
  status        String    @default("pending") @db.VarChar(20)
  estimatedTime String?   @map("estimated_time") @db.VarChar(50)
  actualTime    DateTime? @map("actual_time")
  createdAt     DateTime  @default(now()) @map("created_at")

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver DeliveryDriver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@map("deliveries")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  rating    Int
  comment   String?  @db.Text
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}

model WalletTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String   @db.VarChar(10)
  amount      Int
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}
